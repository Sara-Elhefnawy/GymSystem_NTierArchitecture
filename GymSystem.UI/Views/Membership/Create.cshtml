@model CreateMembershipViewModel

<div class="container mt-4">
    <header class="mb-4">
        <h3 class="text-primary-color">Create Membership</h3>
        <p class="text-muted">Assign a plan to a member</p>
    </header>

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()

                        <div class="row g-3">
                            <div class="col-12">
                                <label asp-for="MemberId" class="form-label fw-semibold">
                                    Member <span class="text-danger">*</span>
                                </label>
                                <select asp-for="MemberId" asp-items="ViewBag.Members" class="form-select">
                                    <option value="">-- Select Member --</option>
                                </select>
                                <span asp-validation-for="MemberId" class="text-danger"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="PlanId" class="form-label fw-semibold">
                                    Plan <span class="text-danger">*</span>
                                </label>
                                <select asp-for="PlanId" asp-items="ViewBag.Plans" class="form-select">
                                    <option value="">-- Select Plan --</option>
                                </select>
                                <span asp-validation-for="PlanId" class="text-danger"></span>
                            </div>
                        </div>

                        @if (TempData["Info"] != null)
                        {
                            <div class="alert alert-info mt-3">
                                <i class="bi bi-info-circle me-2"></i>@TempData["Info"]
                            </div>
                        }

                        <div class="d-flex justify-content-between mt-4 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-outline">
                                <i class="bi bi-arrow-left me-1"></i>Cancel
                            </a>
                            <button type="submit" class="btn btn-fill">
                                <i class="bi bi-plus-lg me-1"></i>Create Membership
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
