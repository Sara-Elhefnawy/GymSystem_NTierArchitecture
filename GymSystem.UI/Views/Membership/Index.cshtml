@model IReadOnlyList<IndexMembershipViewModel>

@{
    ViewData["Title"] = "Memberships";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary-color">Active Memberships</h2>
        <a asp-action="Create" class="btn-fill">Create New Membership</a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">
            <i class="bi bi-info-circle"></i> No active memberships found.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>QR Code</th>
                        <th>Member</th>
                        <th>Plan</th>
                        <th>Start Date</th>
                        <th>End Date</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <!-- QR Code -->
                                <div class="qr-code-container">
                                    <img src="@item.QrCodeUrl"
                                         alt="QR Code for @item.MemberName"
                                         class="qr-code-img"
                                         style="width: 50px; height: 50px; cursor: pointer; border-radius: 4px;" />

                                    <button type="button" class="btn btn-sm btn-outline-primary mt-1"
                                            data-bs-toggle="modal"
                                            data-bs-target="#qrModal_@item.MemberId">
                                        <i class="bi bi-qr-code"></i> View
                                    </button>
                                </div>
                            </td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <img src="@Url.Action("GetPhoto", "Member", new { id = item.MemberId })"
                                         alt="@item.MemberName"
                                         class="rounded-circle me-2"
                                         style="width: 30px; height: 30px; object-fit: cover;"
                                         onerror="this.src='/images/User.png'" />
                                    <span>@item.MemberName</span>
                                </div>
                            </td>
                            <td>@item.PlanName</td>
                            <td>@item.StartDate.ToString("yyyy-MM-dd")</td>
                            <td>@item.EndDate.ToString("yyyy-MM-dd")</td>
                            <td>
                                <span class="badge @item.StatusBadgeClass">@item.Status</span>
                                <small class="d-block text-muted">@item.DaysLeft days left</small>
                            </td>
                            <td>
                                <form asp-action="Cancel" asp-controller="Membership" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn btn-sm btn-danger"
                                            onclick="return confirm('Are you sure you want to cancel the membership for @item.MemberName?')">
                                        <i class="bi bi-x-circle"></i> Cancel
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
