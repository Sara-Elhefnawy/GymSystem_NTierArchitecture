@model IReadOnlyList<SessionInBookingViewModel>

@{
    ViewData["Title"] = "Session Attendance";
    var sessionId = ViewContext.RouteData.Values["id"] ?? ViewData["SessionId"];
}

<div class="container">
    <header class="d-flex justify-content-between mt-5 mb-4 align-items-center">
        <div>
            <h2 class="text-primary-color mb-0">
                <i class="bi bi-clipboard-check me-2"></i>Session Attendance
            </h2>
            <p class="text-muted">Mark attendance for members</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Scan" asp-controller="CheckIn" class="btn btn-success">
                <i class="bi bi-qr-code-scan me-1"></i> Scan QR
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Back to Sessions
            </a>
        </div>
    </header>

    @if (Model != null && Model.Any())
    {
        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">#</th>
                                <th>Member</th>
                                <th>Booking Date</th>
                                <th>Attendance Status</th>
                                <th class="text-center pe-4">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int counter = 1;
                            }
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4">@counter</td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <img src="@Url.Action("GetPhoto", "Member", new { id = item.MemberId })"
                                                 class="rounded-circle"
                                                 style="width:40px;height:40px;object-fit:cover;"
                                                 onerror="this.src='/images/User.png'" />
                                            <span class="ms-2 fw-medium">@item.MemberName</span>
                                        </div>
                                    </td>
                                    <td>@(item.BookingDate?.ToString("MMM dd, yyyy hh:mm tt") ?? "N/A")</td>
                                    <td>
                                        @if (item.IsAttended)
                                        {
                                            <span class="badge bg-success">
                                                <i class="bi bi-check-circle-fill me-1"></i> Attended
                                                @if (item.AttendanceMarkedAt.HasValue)
                                                {
                                                    <br />
                                                    <small>@item.AttendanceMarkedAt.Value.ToString("hh:mm tt")</small>
                                                }
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">
                                                <i class="bi bi-clock-fill me-1"></i> Pending
                                            </span>
                                        }
                                    </td>
                                    <td class="text-center pe-4">
                                        @if (!item.IsAttended)
                                        {
                                            <form method="post" asp-action="Attended" class="m-0 d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="memberId" value="@item.MemberId" />
                                                <input type="hidden" name="sessionId" value="@item.SessionId" />
                                                <button type="submit" class="btn btn-success btn-sm">
                                                    <i class="bi bi-check-circle me-1"></i> Mark Attended
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-success fw-bold">
                                                <i class="bi bi-check-circle-fill me-1"></i> Completed
                                            </span>
                                        }
                                    </td>
                                </tr>
                                counter++;
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card-footer bg-white border-0">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="badge bg-success">@Model.Count(x => x.IsAttended) Attended</span>
                        <span class="badge bg-warning text-dark ms-1">@Model.Count(x => !x.IsAttended) Pending</span>
                    </div>
                    <span class="text-muted">Total: @Model.Count() members</span>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="bi bi-person-workspace display-1 text-muted"></i>
            <h4 class="mt-3 text-muted">No Members Available</h4>
            <p class="text-muted">No members have booked this session yet</p>
            <a asp-action="Create" asp-route-id="@sessionId" class="btn btn-fill fw-medium rounded-pill px-4 py-3 mt-3">
                <i class="bi bi-plus-lg me-2"></i>Add Booking
            </a>
        </div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
