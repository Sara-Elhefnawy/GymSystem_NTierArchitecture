@model IReadOnlyList<IndexSessionViewModel>
@{
    ViewData["Title"] = "Sessions";
}

<div class="container">
    <header class="d-flex justify-content-between mt-5 mb-4 align-items-center">
        <div>
            <h2 class="text-primary-color mb-0">Training Sessions</h2>
            <p class="text-muted">Manage gym training sessions and classes</p>
        </div>
        <a asp-controller="Session" asp-action="ChooseCategory" class="btn btn-fill fw-medium rounded-pill px-4 py-3">
            <i class="bi bi-plus-lg me-2"></i>Add Session
        </a>
    </header>

    @if (Model != null && Model.Any())
    {
        // Group sessions by status
        var ongoingSessions = Model.Where(s => s.Status.ToString() == "Ongoing").ToList();
        var upcomingSessions = Model.Where(s => s.Status.ToString() == "Upcoming").ToList();
        var completedSessions = Model.Where(s => s.Status.ToString() == "Completed").ToList();

        @if (ongoingSessions.Any())
        {
            <div class="mb-5">
                <div class="d-flex align-items-center mb-3">
                    <div class="status-indicator ongoing me-2"></div>
                    <h4 class="mb-0 text-primary-color">
                        <i class="bi bi-play-circle-fill me-2"></i>Ongoing Sessions
                    </h4>
                    <span class="badge bg-success ms-2 rounded-pill">@ongoingSessions.Count</span>
                </div>
                <div class="row g-4">
                    @foreach (var session in ongoingSessions)
                    {
                        @await Html.PartialAsync("_SessionCard", session)
                    }
                </div>
            </div>
        }

        @if (upcomingSessions.Any())
        {
            <div class="mb-5">
                <div class="d-flex align-items-center mb-3">
                    <div class="status-indicator upcoming me-2"></div>
                    <h4 class="mb-0 text-primary-color">
                        <i class="bi bi-clock-history me-2"></i>Upcoming Sessions
                    </h4>
                    <span class="badge bg-primary ms-2 rounded-pill">@upcomingSessions.Count</span>
                </div>
                <div class="row g-4">
                    @foreach (var session in upcomingSessions)
                    {
                        @await Html.PartialAsync("_SessionCard", session)
                    }
                </div>
            </div>
        }

        @if (completedSessions.Any())
        {
            <div class="mb-5">
                <div class="d-flex align-items-center mb-3">
                    <div class="status-indicator completed me-2"></div>
                    <h4 class="mb-0 text-muted">
                        <i class="bi bi-check-circle me-2"></i>Completed Sessions
                    </h4>
                    <span class="badge bg-secondary ms-2 rounded-pill">@completedSessions.Count</span>
                </div>
                <div class="row g-4">
                    @foreach (var session in completedSessions)
                    {
                        @await Html.PartialAsync("_SessionCard", session)
                    }
                </div>
            </div>
        }
    }
    else
    {
        <div class="text-center py-5">
            <i class="bi bi-calendar-x display-1 text-muted"></i>
            <h4 class="mt-3 text-muted">No Sessions Available</h4>
            <p class="text-muted">Create your first training session to get started</p>
        </div>
    }
</div>

<style>
    .status-indicator {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        display: inline-block;
    }

        .status-indicator.ongoing {
            background-color: #28a745;
            box-shadow: 0 0 8px rgba(40, 167, 69, 0.4);
            animation: pulse 2s infinite;
        }

        .status-indicator.upcoming {
            background-color: #0d6efd;
        }

        .status-indicator.completed {
            background-color: #6c757d;
        }

    @@keyframes pulse {
        0% {
            box-shadow: 0 0 0 0 rgba(40, 167, 69, 0.4);
        }

        70% {
            box-shadow: 0 0 0 8px rgba(40, 167, 69, 0);
        }

        100% {
            box-shadow: 0 0 0 0 rgba(40, 167, 69, 0);
        }
    }

    .session-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .session-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 20px rgba(0,0,0,0.12) !important;
        }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
