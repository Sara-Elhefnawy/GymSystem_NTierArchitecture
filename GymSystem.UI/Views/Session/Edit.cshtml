@model EditSessionViewModel
@{
    ViewData["Title"] = "Edit Session";
}

<div class="container mt-4">
    <header class="mb-4">
        <h3 class="text-primary-color">Edit Session</h3>
        <p class="text-muted">Update session information</p>
    </header>

    @if (!string.IsNullOrEmpty(Model?.Status) && !Model.CanEdit)
    {
        <div class="alert alert-warning mb-4">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            <strong>Session @Model.Status</strong> - This session cannot be edited because it has already started or completed.
        </div>
    }

    <form asp-action="Edit" asp-controller="Session" asp-route-id="@Model.Id" method="post" id="editForm">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card shadow-sm border-0">
                    <div class="card-body p-4">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <!-- Display-only fields -->
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold text-muted">Category</label>
                                <div class="form-control-plaintext">@Model.CategoryName</div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold text-muted">Max Capacity</label>
                                <div class="form-control-plaintext">@Model.MaxCapacity participants</div>
                            </div>
                        </div>

                        <hr />

                        <!-- Editable fields -->
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="TrainerId" class="form-label fw-semibold">
                                    Trainer <span class="text-danger">*</span>
                                </label>

                                <select asp-for="TrainerId" asp-items="@(Model.TrainerList)" class="form-select" disabled="@(!Model.CanEdit)">
                                    <option value="">-- Select Trainer --</option>
                                </select>

                                <span asp-validation-for="TrainerId" class="text-danger"></span>
                                <small class="text-muted">Only trainers qualified for @Model.CategoryName are shown</small>
                            </div>

                            <div class="col-12">
                                <label asp-for="Description" class="form-label fw-semibold">
                                    Description <span class="text-danger">*</span>
                                </label>
                                <textarea asp-for="Description" class="form-control" rows="3"
                                          placeholder="Update session description..." readonly="@(!Model.CanEdit)"></textarea>
                                <span asp-validation-for="Description" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Date & Time -->
                        <div class="section-header mb-3">
                            <h5 class="text-primary fw-bold">Date & Time</h5>
                            <hr class="mt-2">
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="StartDate" class="form-label fw-semibold">
                                    Start Date & Time <span class="text-danger">*</span>
                                </label>
                                <input asp-for="StartDate" type="datetime-local" class="form-control"
                                       value="@Model.StartDate.ToString("yyyy-MM-ddTHH:mm")" readonly="@(!Model.CanEdit)" />
                                <span asp-validation-for="StartDate" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="EndDate" class="form-label fw-semibold">
                                    End Date & Time <span class="text-danger">*</span>
                                </label>
                                <input asp-for="EndDate" type="datetime-local" class="form-control"
                                       value="@Model.EndDate.ToString("yyyy-MM-ddTHH:mm")" readonly="@(!Model.CanEdit)" />
                                <span asp-validation-for="EndDate" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between mt-4 pt-3 border-top">
                            <div>
                                <a asp-action="Index" class="btn btn-outline-secondary">
                                    <i class="bi bi-arrow-left me-1"></i>Cancel
                                </a>
                                @if (Model.CanEdit)
                                {
                                    <button type="reset" class="btn btn-outline-secondary ms-2">
                                        <i class="bi bi-arrow-counterclockwise me-1"></i>Reset
                                    </button>
                                }
                            </div>
                            @if (Model.CanEdit)
                            {
                                <button type="submit" class="btn btn-fill">
                                    <i class="bi bi-check-lg me-1"></i>Update Session
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Optional: Add confirmation before reset
        document.querySelector('button[type="reset"]')?.addEventListener('click', function(e) {
            if (!confirm('Are you sure you want to reset all changes?')) {
                e.preventDefault();
            }
        });

        // Optional: Auto-reset for datetime fields (they don't reset by default)
        document.querySelector('button[type="reset"]')?.addEventListener('click', function(e) {
            // For datetime-local inputs, we need to manually reset them
            const form = document.getElementById('editForm');
            const originalValues = new Map();

            // Store original values on page load
            document.querySelectorAll('input[type="datetime-local"]').forEach(input => {
                originalValues.set(input.id, input.defaultValue);
            });

            // Restore original values on reset
            originalValues.forEach((value, id) => {
                const input = document.getElementById(id);
                if (input) {
                    input.value = value;
                }
            });
        });
    </script>
}
