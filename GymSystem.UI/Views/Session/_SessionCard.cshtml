@model IndexSessionViewModel

<div class="col-12 col-md-6 col-lg-4">
    <div class="card h-100 shadow-sm border-0 session-card">
        <div class="card-header text-white py-3 @(Model.HeaderClass)">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0">
                    <i class="bi bi-calendar-event me-2"></i>@Model.CategoryName
                </h5>
                <span class="badge
                @(Model.Status.ToString() == "Ongoing" ? "bg-success" :
                                    Model.Status.ToString() == "Upcoming" ? "bg-primary" :
                              "bg-secondary")
                text-white">@Model.Status</span>
            </div>
        </div>
        <div class="card-body">
            <p class="text-muted mb-3">@Model.Description</p>

            <div class="session-info mb-3">
                <div class="info-item mb-2">
                    <i class="bi bi-person-circle text-primary-color me-2"></i>
                    <strong>Trainer:</strong> @Model.TrainerName
                </div>
                <div class="info-item mb-2">
                    <i class="bi bi-calendar3 text-primary-color me-2"></i>
                    <strong>Date:</strong> @Model.StartDate.ToString("MMMM dd, yyyy")
                </div>
                <div class="info-item mb-2">
                    <i class="bi bi-clock text-primary-color me-2"></i>
                    <strong>Time:</strong> @Model.StartDate.ToString("hh:mm tt") – @Model.EndDate.ToString("hh:mm tt")
                </div>
                <div class="info-item mb-2">
                    <i class="bi bi-hourglass-split text-primary-color me-2"></i>
                    <strong>Duration:</strong> @Model.Duration.ToString(@"hh\:mm\:ss")
                </div>
                <div class="info-item">
                    <i class="bi bi-people text-primary-color me-2"></i>
                    <strong>Capacity:</strong> @Model.AvailableSlots / @Model.MaxCapacity slots
                </div>
            </div>
        </div>
        <div class="card-footer bg-white border-0">
            <div class="d-grid gap-2">
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline btn-sm">
                    <i class="bi bi-eye me-1"></i>View Details
                </a>
                @if (Model.Status.ToString() != "Completed")
                {
                    <div class="d-flex gap-2">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline btn-sm flex-fill">
                            <i class="bi bi-pencil me-1"></i>Edit
                        </a>
                        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline text-danger btn-sm flex-fill">
                            <i class="bi bi-trash me-1"></i>Delete
                        </a>
                    </div>
                }
                else
                {
                    <div class="text-center text-muted small">
                        <i class="bi bi-lock me-1"></i>Completed sessions cannot be modified
                    </div>
                }
            </div>
        </div>
    </div>
</div>
