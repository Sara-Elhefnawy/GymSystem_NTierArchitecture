@using GymSystem.UI.ViewModels
@model ErrorViewModel
@{
    ViewData["Title"] = "Oops! Something went wrong";
    Layout = "_Layout";
}

<div class="container text-center py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="mb-4">
                <i class="fas fa-sad-tear" style="font-size: 80px; color: #f39c12;"></i>
            </div>

            <h1 class="display-4 mb-3">Oops!</h1>
            <h2 class="h4 text-muted mb-4">Something went wrong on our end.</h2>

            <div class="alert alert-warning alert-dismissible fade show" role="alert">
                <p class="mb-0">
                    <strong>Don't worry!</strong> Our team has been notified and we're working on it.
                </p>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>

            <div class="mt-4">
                <!-- return home page -->
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg me-2">
                    <i class="fas fa-home"></i> Go Home
                </a>
                <button onclick="location.reload();" class="btn btn-outline-secondary btn-lg">
                    <i class="fas fa-sync-alt"></i> Try Again
                </button>
            </div>

            <!-- Optional: Technical Details (collapsed by default) -->
            <div class="mt-5">
                <button class="btn btn-link btn-sm text-muted" type="button" data-bs-toggle="collapse" data-bs-target="#errorDetails">
                    Show technical details
                </button>
                <div class="collapse mt-3" id="errorDetails">
                    <div class="card card-body bg-light">
                        <small>
                            <strong>Request ID:</strong><br>
                            <code class="text-muted">@Model.RequestId</code>
                        </small>
                        @if (ViewBag.ErrorMessage != null)
                        {
                            <small class="mt-2">
                                <strong>Error:</strong><br>
                                <code class="text-muted">@ViewBag.ErrorMessage</code>
                            </small>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>