@using GymSystem.Domain.DTOs.Member
@using GymSystem.Infrastructure.Entities.Enums
@model CreateMemberDTO

@{
    ViewData["Title"] = "Create Member";
}

<div class="container mt-4">
    <h2>Create New Member</h2>

    <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="display: none;"></div>

    <div id="globalErrors" class="alert alert-danger" style="display: none;">
        <ul id="globalErrorsList"></ul>
    </div>

    <form asp-action="Create" method="post" id="createMemberForm">
        <!-- Optional: Custom global error display -->
        <div id="globalErrorContainer" class="alert alert-danger" style="display: none;">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <span id="globalErrorMessage"></span>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="mb-3">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="mb-3">
                    <label asp-for="Gender" class="form-label"></label>
                    <select asp-for="Gender" class="form-select" asp-items="Html.GetEnumSelectList<Gender>()">
                        <option value="">-- Select Gender --</option>
                    </select>
                    <span asp-validation-for="Gender" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" type="email" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="mb-3">
                    <label asp-for="Phone" class="form-label"></label>
                    <input asp-for="Phone" class="form-control" />
                    <span asp-validation-for="Phone" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                <div class="mb-3">
                    <label asp-for="DateOfBirth" class="form-label"></label>
                    <input asp-for="DateOfBirth" type="date" class="form-control" />
                    <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                </div>
            </div>
        </div>

        <h4>Address</h4>
        <div class="row">
            <div class="col-md-4">
                <div class="mb-3">
                    <label asp-for="BuildingNumber" class="form-label"></label>
                    <input asp-for="BuildingNumber" class="form-control" />
                    <span asp-validation-for="BuildingNumber" class="text-danger"></span>
                </div>
            </div>
            <div class="col-md-4">
                <div class="mb-3">
                    <label asp-for="Street" class="form-label"></label>
                    <input asp-for="Street" class="form-control" />
                    <span asp-validation-for="Street" class="text-danger"></span>
                </div>
            </div>
            <div class="col-md-4">
                <div class="mb-3">
                    <label asp-for="City" class="form-label"></label>
                    <input asp-for="City" class="form-control" />
                    <span asp-validation-for="City" class="text-danger"></span>
                </div>
            </div>
        </div>

        <h4>Health Record</h4>
        <div class="row">
            <div class="col-md-4">
                <div class="mb-3">
                    <label asp-for="HealthRecord.Height" class="form-label"></label>
                    <input asp-for="HealthRecord.Height" class="form-control" step="0.01" />
                    <span asp-validation-for="HealthRecord.Height" class="text-danger"></span>
                </div>
            </div>
            <div class="col-md-4">
                <div class="mb-3">
                    <label asp-for="HealthRecord.Weight" class="form-label"></label>
                    <input asp-for="HealthRecord.Weight" class="form-control" step="0.01" />
                    <span asp-validation-for="HealthRecord.Weight" class="text-danger"></span>
                </div>
            </div>
            <div class="col-md-4">
                <div class="mb-3">
                    <label asp-for="HealthRecord.BloodType" class="form-label"></label>
                    <select asp-for="HealthRecord.BloodType" class="form-select">
                        <option value="">-- Select Blood Type --</option>
                        @foreach (BloodType bloodType in Enum.GetValues(typeof(BloodType)))
                        {
                            var displayName = bloodType.ToString().Replace('_', ' ');
                            <option value="@bloodType.ToString()">@displayName</option>
                        }
                    </select>
                    <span asp-validation-for="HealthRecord.BloodType" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="HealthRecord.Note" class="form-label"></label>
            <textarea asp-for="HealthRecord.Note" class="form-control" rows="3"></textarea>
            <span asp-validation-for="HealthRecord.Note" class="text-danger"></span>
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-primary">Create Member</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}